# 使用 scripts/init-env.sh 复制为 `.env`；生成值仅用于本地开发。
COMPOSE_PROJECT_NAME=food-delivery

MYSQL_IMAGE=docker.io/library/mysql:8.4
MYSQL_PORT=3306
MYSQL_DATABASE=food_delivery
MYSQL_USER=delivery
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

REDIS_IMAGE=docker.io/library/redis:7.4-alpine
REDIS_PORT=6379
REDIS_PASSWORD=change-me

MINIO_IMAGE=quay.io/minio/minio:latest
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=food_delivery
MINIO_ROOT_PASSWORD=change-me
# 可选：返回给浏览器的图片地址，默认与 MINIO_ENDPOINT（http://127.0.0.1:9000）相同。
# MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
# 可选：图片桶名和单张图片大小上限（字节），默认 food-delivery 和 5242880（5MB）。
# MINIO_BUCKET=food-delivery
# MINIO_MAX_FILE_SIZE=5242880

JWT_SECRET=change-me
AMAP_WEB_API_KEY=
AMAP_JS_API_KEY=
