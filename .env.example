COMPOSE_PROJECT_NAME=food-delivery

MYSQL_IMAGE=docker.io/library/mysql:8.4
MYSQL_PORT=3306
MYSQL_DATABASE=food_delivery
MYSQL_USER=delivery
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

REDIS_IMAGE=docker.io/library/redis:7.4-alpine
